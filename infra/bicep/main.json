{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.45.15.27210",
      "templateHash": "13682181367630686278"
    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "defaultValue": "mvp",
      "metadata": {
        "description": "Short environment suffix for globally unique names."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region. Prefer chilecentral when Container Apps is available."
      }
    },
    "containerImage": {
      "type": "string",
      "metadata": {
        "description": "Container image tag to deploy, for example <acr>.azurecr.io/ecloe-engine:<git-sha>."
      }
    },
    "acrName": {
      "type": "string",
      "defaultValue": "ecloedemo1266",
      "metadata": {
        "description": "Existing Azure Container Registry name that contains the deployed image."
      }
    },
    "containerAppsEnvironmentName": {
      "type": "string",
      "defaultValue": "ecloe-demo-aca-env",
      "metadata": {
        "description": "Existing Azure Container Apps environment name reused by the Engine runtime."
      }
    },
    "cosmosAccountName": {
      "type": "string",
      "defaultValue": "ecloe5cosmos1266cl",
      "metadata": {
        "description": "Existing Cosmos DB account name."
      }
    },
    "cosmosDatabaseName": {
      "type": "string",
      "defaultValue": "ecloe",
      "metadata": {
        "description": "Existing Cosmos DB database name."
      }
    },
    "ecloePaySqlServerName": {
      "type": "string",
      "defaultValue": "ecloe-sql-1266",
      "metadata": {
        "description": "Existing Azure SQL logical server name for ECloe Pay demo persistence."
      }
    },
    "ecloePaySqlDatabaseName": {
      "type": "string",
      "defaultValue": "ecloe_validation",
      "metadata": {
        "description": "Existing Azure SQL database name for ECloe Pay demo persistence."
      }
    },
    "ecloePaySqlDriver": {
      "type": "string",
      "defaultValue": "ODBC Driver 18 for SQL Server",
      "metadata": {
        "description": "ODBC driver expected in the ECloe Pay runtime image."
      }
    },
    "entraTenantId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Entra tenant ID."
      }
    },
    "entraClientId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Entra client/application ID for the API."
      }
    },
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Existing Key Vault containing runtime secrets."
      }
    },
    "flaskSecretName": {
      "type": "string",
      "defaultValue": "ecloe-flask-secret-key",
      "metadata": {
        "description": "Key Vault secret name for the Flask signing key."
      }
    },
    "subjectKeySaltSecretName": {
      "type": "string",
      "defaultValue": "ecloe-subject-key-salt",
      "metadata": {
        "description": "Key Vault secret name for the subject pseudonymization salt."
      }
    },
    "rateLimitRedisSecretName": {
      "type": "string",
      "defaultValue": "ecloe-rate-limit-redis-url",
      "metadata": {
        "description": "Key Vault secret name containing the Redis URL."
      }
    },
    "targetPort": {
      "type": "int",
      "defaultValue": 8000,
      "metadata": {
        "description": "Container App external ingress port."
      }
    }
  },
  "variables": {
    "unique": "[uniqueString(resourceGroup().id, parameters('environmentName'))]",
    "storageName": "[toLower(format('ecloeart{0}', variables('unique')))]",
    "appInsightsName": "[format('ecloe-ai-{0}', parameters('environmentName'))]",
    "appName": "[format('ecloe-engine-{0}', parameters('environmentName'))]",
    "artifactContainerName": "ecloe-artifacts",
    "keyVaultSecretIdentity": "system"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/default/{1}', variables('storageName'), variables('artifactContainerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web"
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Multiple",
          "ingress": {
            "external": true,
            "targetPort": "[parameters('targetPort')]"
          },
          "secrets": [
            {
              "name": "subject-key-salt",
              "identity": "[variables('keyVaultSecretIdentity')]",
              "keyVaultUrl": "[format('{0}secrets/{1}', reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri, parameters('subjectKeySaltSecretName'))]"
            },
            {
              "name": "flask-secret-key",
              "identity": "[variables('keyVaultSecretIdentity')]",
              "keyVaultUrl": "[format('{0}secrets/{1}', reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri, parameters('flaskSecretName'))]"
            },
            {
              "name": "rate-limit-redis-url",
              "identity": "[variables('keyVaultSecretIdentity')]",
              "keyVaultUrl": "[format('{0}secrets/{1}', reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri, parameters('rateLimitRedisSecretName'))]"
            }
          ],
          "registries": [
            {
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), '2023-11-01-preview').loginServer]",
              "identity": "system"
            }
          ]
        },
        "template": {
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 1
          },
          "containers": [
            {
              "name": "ecloe-engine",
              "image": "[parameters('containerImage')]",
              "env": [
                {
                  "name": "APP_ENVIRONMENT",
                  "value": "cloud"
                },
                {
                  "name": "API_HOST",
                  "value": "0.0.0.0"
                },
                {
                  "name": "AUTH_MODE",
                  "value": "entra_id"
                },
                {
                  "name": "ENTRA_TENANT_ID",
                  "value": "[parameters('entraTenantId')]"
                },
                {
                  "name": "ENTRA_CLIENT_ID",
                  "value": "[parameters('entraClientId')]"
                },
                {
                  "name": "ENTRA_AUDIENCE",
                  "value": "[format('api://{0}', parameters('entraClientId'))]"
                },
                {
                  "name": "RATE_LIMIT_BACKEND",
                  "value": "redis"
                },
                {
                  "name": "RATE_LIMIT_REDIS_URL",
                  "secretRef": "rate-limit-redis-url"
                },
                {
                  "name": "FLASK_SECRET_KEY",
                  "secretRef": "flask-secret-key"
                },
                {
                  "name": "SUBJECT_KEY_SALT",
                  "secretRef": "subject-key-salt"
                },
                {
                  "name": "DECISION_REPOSITORY_MODE",
                  "value": "cosmos"
                },
                {
                  "name": "AZURE_COSMOS_AUTH_MODE",
                  "value": "managed_identity"
                },
                {
                  "name": "AZURE_COSMOS_ENDPOINT",
                  "value": "[format('https://{0}.documents.azure.com:443/', parameters('cosmosAccountName'))]"
                },
                {
                  "name": "AZURE_COSMOS_DATABASE",
                  "value": "[parameters('cosmosDatabaseName')]"
                },
                {
                  "name": "ARTIFACT_SOURCE",
                  "value": "azure_blob"
                },
                {
                  "name": "AZURE_STORAGE_ACCOUNT_URL",
                  "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').primaryEndpoints.blob]"
                },
                {
                  "name": "AZURE_BLOB_CONTAINER_ARTIFACTS",
                  "value": "[variables('artifactContainerName')]"
                },
                {
                  "name": "AZURE_ARTIFACT_PROMOTION_BLOB",
                  "value": "promoted/current.json"
                },
                {
                  "name": "ARTIFACT_CACHE_DIR",
                  "value": "/tmp/ecloe/artifacts"
                },
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]"
                },
                {
                  "name": "ECLOE_PAY_DATABASE_MODE",
                  "value": "azure_sql"
                },
                {
                  "name": "ECLOE_PAY_SQL_SERVER",
                  "value": "[format('{0}{1}', parameters('ecloePaySqlServerName'), environment().suffixes.sqlServerHostname)]"
                },
                {
                  "name": "ECLOE_PAY_SQL_DATABASE",
                  "value": "[parameters('ecloePaySqlDatabaseName')]"
                },
                {
                  "name": "ECLOE_PAY_SQL_AUTH_MODE",
                  "value": "managed_identity"
                },
                {
                  "name": "ECLOE_PAY_SQL_DRIVER",
                  "value": "[parameters('ecloePaySqlDriver')]"
                },
                {
                  "name": "ECLOE_PAY_COOKIE_SECURE",
                  "value": "true"
                }
              ],
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), variables('appName'), 'Storage Blob Data Reader')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '2a2b9908-6ea1-4ae2-8e65-a410df84e7d1')]",
        "principalId": "[reference(resourceId('Microsoft.App/containerApps', variables('appName')), '2024-03-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', variables('appName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), variables('appName'), 'AcrPull')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
        "principalId": "[reference(resourceId('Microsoft.App/containerApps', variables('appName')), '2024-03-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', variables('appName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), variables('appName'), 'Key Vault Secrets User')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
        "principalId": "[reference(resourceId('Microsoft.App/containerApps', variables('appName')), '2024-03-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', variables('appName'))]"
      ]
    }
  ],
  "outputs": {
    "containerAppName": {
      "type": "string",
      "value": "[variables('appName')]"
    },
    "containerAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('appName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "acrLoginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), '2023-11-01-preview').loginServer]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageName')]"
    },
    "artifactContainer": {
      "type": "string",
      "value": "[variables('artifactContainerName')]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', variables('appName')), '2024-03-01', 'full').identity.principalId]"
    },
    "cosmosDataContributorCommand": {
      "type": "string",
      "value": "[format('scripts/grant_cosmos_data_contributor.ps1 -AccountName {0} -DatabaseName {1} -PrincipalId {2}', parameters('cosmosAccountName'), parameters('cosmosDatabaseName'), reference(resourceId('Microsoft.App/containerApps', variables('appName')), '2024-03-01', 'full').identity.principalId)]"
    },
    "ecloePaySqlServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Sql/servers', parameters('ecloePaySqlServerName')), '2023-08-01-preview').fullyQualifiedDomainName]"
    },
    "ecloePaySqlDatabase": {
      "type": "string",
      "value": "[parameters('ecloePaySqlDatabaseName')]"
    }
  }
}
# Kaggle
# Download your token from https://www.kaggle.com/settings/account
KAGGLE_USERNAME=
KAGGLE_KEY=

# Dataset
KAGGLE_DATASET=bofulee/kevin-hillstrom-minethatdata-e-mailanalytics
RAW_FILENAME=hillstrom.csv
PROCESSED_FILENAME=hillstrom_processed.csv
RANDOM_SEED=42

# Local data folders
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
REPORTS_DIR=reports

# API perimeter
# Local development can keep AUTH_MODE=disabled only with API_HOST=127.0.0.1.
# Cloud environments must use AUTH_MODE=entra_id and AZURE_COSMOS_AUTH_MODE=managed_identity.
APP_ENVIRONMENT=local
API_HOST=127.0.0.1
AUTH_MODE=disabled
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
ENTRA_ISSUER=
ENTRA_JWKS_URL=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
TRUSTED_HOSTS=127.0.0.1,localhost
MAX_PAYLOAD_BYTES=65536
MAX_CONCURRENT_REQUESTS=16
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=
FLASK_SECRET_KEY=local-dev-flask-secret-key
SUBJECT_KEY_SALT=local-dev-subject-key-salt

DECISION_EVENT_TTL_SECONDS=157680000
DECISION_REPOSITORY_MODE=file
DECISION_EVENTS_FILE=reports/decision_events.jsonl

# Azure resources
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_BLOB_CONTAINER_RAW=ecloe-raw
AZURE_BLOB_CONTAINER_PROCESSED=ecloe-processed
AZURE_BLOB_CONTAINER_ARTIFACTS=ecloe-artifacts
AZURE_ARTIFACT_PROMOTION_BLOB=promoted/current.json
AZURE_ARTIFACT_PROMOTION_BLOB_MARKET=promoted/market/current.json
AZURE_ARTIFACT_PROMOTION_BLOB_PAY=promoted/pay/current.json
ARTIFACT_SOURCE=file
ARTIFACT_CACHE_DIR=.artifact_cache
AZURE_COSMOS_ENDPOINT=https://ecloe5cosmos1266cl.documents.azure.com:443/
AZURE_COSMOS_KEY=
AZURE_COSMOS_AUTH_MODE=key
AZURE_COSMOS_DATABASE=ecloe
AZURE_COSMOS_CONTAINER_DECISIONS=decisions
AZURE_COSMOS_CONTAINER_REWARDS=rewards
AZURE_COSMOS_CONTAINER_POLICIES=policy_versions

# ECloe Pay simulated banking surface
# Default memory mode needs no SQL driver and creates no real user or bank account.
ECLOE_PAY_DATABASE_MODE=memory
ECLOE_PAY_SQL_SERVER=ecloe-sql-1266.database.windows.net
ECLOE_PAY_SQL_DATABASE=ecloe_validation
ECLOE_PAY_SQL_AUTH_MODE=entra_interactive
ECLOE_PAY_SQL_DRIVER=ODBC Driver 18 for SQL Server
ECLOE_PAY_SESSION_TTL_SECONDS=28800
ECLOE_PAY_COOKIE_SECURE=false
ECLOE_PAY_DEMO_USER_EMAIL=demo.pay@ecloe.local
ECLOE_PAY_DEMO_USER_PASSWORD=change-this-demo-password
ECLOE_PAY_INITIAL_BALANCE_CENTS=50000

# Customer web authentication. Use local_signup for lightweight Azure SQL-backed signup without Entra.
ECLOE_WEB_AUTH_MODE=local
ECLOE_WEB_ENTRA_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com
ECLOE_WEB_ENTRA_CLIENT_ID=
ECLOE_WEB_ENTRA_CLIENT_SECRET=
ECLOE_WEB_ENTRA_REDIRECT_URI=http://localhost:5000/auth/callback
ECLOE_WEB_ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:5000/
ECLOE_WEB_SESSION_IDLE_SECONDS=1800
ECLOE_WEB_OIDC_FLOW_TTL_SECONDS=600

# ECloe Market simulated marketplace surface
# Default memory mode reads the local synthetic catalog JSON.
ECLOE_MARKET_DATABASE_MODE=memory
ECLOE_MARKET_CATALOG_PATH=data/demo/ecloe_market_catalog.json
ECLOE_MARKET_CATALOG_SEED=426
ECLOE_MARKET_BLOB_CONTAINER=ecloe-market-demo-assets
ECLOE_MARKET_BLOB_PREFIX=catalog
ECLOE_MARKET_CATALOG_AZURE_PATH=data/demo/ecloe_market_catalog.azure.json
ECLOE_MARKET_IMAGE_MODEL_DIR=data/external/HunyuanImage-3
ECLOE_MARKET_IMAGE_BACKEND=zimage-local
ECLOE_MARKET_IMAGE_SPACE=mrfakename/Z-Image-Turbo
ECLOE_MARKET_IMAGE_SPACE_API_NAME=/generate_image
ECLOE_MARKET_IMAGE_SPACE_EXTRA_KWARGS={"height":1024,"width":1024,"num_inference_steps":9,"randomize_seed":false}
ECLOE_MARKET_IMAGE_ZIMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
ECLOE_MARKET_IMAGE_HEIGHT=768
ECLOE_MARKET_IMAGE_WIDTH=768
ECLOE_MARKET_IMAGE_STEPS=8
ECLOE_MARKET_IMAGE_OFFLOAD_MODE=model
RECOMMENDATION_MARKET_POLICY=deterministic_baseline
RECOMMENDATION_PAY_POLICY=deterministic_baseline
# Optional raw Kaggle downloads should stay outside Git, for example:
# data/external/ecommerce-product-images-18k/
# data/external/ecommerce-product-images-18k.zip

# To persist ECloe Engine decisions and rewards in Cosmos DB locally, set:
# DECISION_REPOSITORY_MODE=cosmos
# AZURE_COSMOS_AUTH_MODE=key
# AZURE_COSMOS_KEY=<local-development-key>

# Cloud runtime must use:
# APP_ENVIRONMENT=cloud
# AUTH_MODE=entra_id
# DECISION_REPOSITORY_MODE=cosmos
# AZURE_COSMOS_AUTH_MODE=managed_identity
# ECLOE_PAY_DATABASE_MODE=azure_sql
# ECLOE_PAY_SQL_AUTH_MODE=managed_identity
# ECLOE_WEB_AUTH_MODE=local_signup
# ECLOE_WEB_ENTRA_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com
# ECLOE_WEB_ENTRA_CLIENT_ID=<customer-app-registration-id>
# ECLOE_WEB_ENTRA_CLIENT_SECRET=<Key-Vault-backed-secret>
# ECLOE_WEB_ENTRA_REDIRECT_URI=https://<demo-host>/auth/callback
# ECLOE_WEB_ENTRA_POST_LOGOUT_REDIRECT_URI=https://<demo-host>/
# ECLOE_MARKET_DATABASE_MODE=azure_sql
# ECLOE_MARKET_CATALOG_PATH=data/demo/ecloe_market_catalog.azure.json
# ARTIFACT_SOURCE=azure_blob
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# Do not set AZURE_COSMOS_KEY or AZURE_STORAGE_CONNECTION_STRING in cloud.
